#!/usr/bin/env bash
# git-record - Stage and commit one or more files in a single command.
#
# Usage:
#   git-record file1 file2
#   git-record file1 file2 -m "Fix whatever was broken"

set -euo pipefail

readonly PROGRAM_NAME="git-record"

# Distinct from git's own non-zero exits, so a typo in the invocation is
# distinguishable from a commit git itself refused.
readonly EXIT_USAGE=2

usage() {
  cat <<EOF
Usage: $PROGRAM_NAME [-m <message>] [-n] <file>...

Stage the given paths and commit only those paths. Anything else
already in the index is left staged and uncommitted.

Options:
  -m, --message <msg>  Commit message. Omit to open your editor.
  -n, --dry-run        Print the git commands, change nothing.
  -h, --help           Show this help.
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$1" >&2
  exit "${2:-1}"
}

message=""
have_message=0
dry_run=0
files=()

while (( $# > 0 )); do
  case "$1" in
    -m | --message)
      (( $# >= 2 )) || die "$1 requires an argument" "$EXIT_USAGE"
      message="$2"
      have_message=1
      shift 2
      ;;
    --message=*)
      message="${1#*=}"
      have_message=1
      shift
      ;;
    -n | --dry-run)
      dry_run=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      files+=("$@")
      break
      ;;
    -*)
      die "unknown option: $1" "$EXIT_USAGE"
      ;;
    *)
      files+=("$1")
      shift
      ;;
  esac
done

(( ${#files[@]} > 0 )) || die "no files given; see --help" "$EXIT_USAGE"

git_dir=$(git rev-parse --git-dir 2>/dev/null) \
  || die "not inside a git repository" "$EXIT_USAGE"

# `git commit -- <path>` is impossible mid-merge, but `git add` runs first
# and clears the unmerged index entries, so a git-record that fails here
# would leave the merge staged and ready to complete with content nobody
# resolved. Refuse before the index is touched.
readonly IN_PROGRESS_MARKERS=(
  MERGE_HEAD:merge
  CHERRY_PICK_HEAD:cherry-pick
  REVERT_HEAD:revert
  rebase-merge:rebase
  rebase-apply:rebase
)

for marker in "${IN_PROGRESS_MARKERS[@]}"; do
  [[ -e "$git_dir/${marker%%:*}" ]] || continue

  die "${marker##*:} in progress; git cannot commit a pathspec now" \
    "$EXIT_USAGE"
done

for file in "${files[@]}"; do
  if [[ -e "$file" || -L "$file" ]]; then
    continue
  fi

  # A path that is gone from the worktree but still tracked is a
  # deletion worth recording, not a typo.
  git ls-files --error-unmatch -- "$file" > /dev/null 2>&1 \
    || die "no such file: $file" "$EXIT_USAGE"
done

# Committing with an explicit pathspec keeps the rest of the index out of
# the commit, so git-record never picks up work staged earlier.
commit_args=(commit)
if (( have_message )); then
  commit_args+=(--message "$message")
fi
commit_args+=(-- "${files[@]}")

if (( dry_run )); then
  # %q per element, not "${array[*]}" — a path with a space must come back
  # out as one pasteable argument, not two.
  printf 'would run: git add --'; printf ' %q' "${files[@]}"; printf '\n'
  printf 'would run: git';        printf ' %q' "${commit_args[@]}"; printf '\n'
  exit 0
fi

git add -- "${files[@]}"
git "${commit_args[@]}"
